# secrets
.env
*.env
!.env.example

# runtime data
data/
outbox/
inbox/
done/
failed/
work/

# local validation venv + model caches (heavy, regenerable)
.venv/
venv/
*.venv
models/
.cache/
.hf/

# python
__pycache__/
*.pyc
.pytest_cache/

# scratch validation outputs
_validation/

# raw credential drops (S3 keys etc.)
credentials
*credentials*
*.pem
*Zone.Identifier

# ssh keys for the pod tunnel
secrets/

# speaker-id reference voices (private audio — never commit); keep the README
refs/*
!refs/README.md

# raw meeting audio — never commit any recording, anywhere in the tree
# (data/ and refs/ are already covered above; this also catches loose files
#  dropped in the project root or elsewhere)
*.m4a
*.mp4
*.wav
*.flac
*.mp3
*.aac
*.ogg
*.webm
*.opus
*.mkv

# SQLite name-map database (private speaker names — lives only on the instance)
*.db
*.db-wal
*.db-shm
