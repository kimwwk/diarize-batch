# Copy to .env and fill in. Keep .env private — it holds RunPod keys.

# ---- Where the inbox/outbox live on the Proxmox host ----
# Inside this dir the orchestrator creates: inbox/ outbox/ done/ failed/ work/
DATA_DIR=./data

# ---- RunPod serverless endpoint (the NEW WhisperX endpoint you create) ----
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ---- RunPod S3 network volume (ships the audio file to the worker) ----
# Create an S3 API key under RunPod console > Settings > S3 API Keys.
# Endpoint + region come from your volume's datacenter, e.g. us-il-1:
#   RUNPOD_S3_ENDPOINT=https://s3api-us-il-1.runpod.io/
#   RUNPOD_S3_REGION=us-il-1
RUNPOD_S3_ENDPOINT=
RUNPOD_S3_REGION=
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET_KEY=
# The network volume's ID (this is also the S3 bucket name):
RUNPOD_NETWORK_VOLUME_ID=

# ---- Transcription / diarization options ----
# LANGUAGE: blank = autodetect. Set an ISO code (en, es, fr...) to skip detection
# — faster, and avoids the cold-start language misdetect on the first seconds.
# Recommended when your meetings are consistently one language.
LANGUAGE=en
DIARIZE=true
MODEL=large-v3
# COMPUTE_TYPE: float16 = fast, ~equal quality, half the VRAM (safe default).
# float32 = max quality, 2x VRAM, slower — fine on the 24GB+ serverless worker.
COMPUTE_TYPE=float32
# Speaker-count hints — set when known; a big accuracy win (e.g. a 1:1 call = 2).
MIN_SPEAKERS=
MAX_SPEAKERS=
# INITIAL_PROMPT: optional. Seed Whisper with domain vocab / names / acronyms to
# improve their spelling, e.g. "Meetily, RunPod, pyannote, WhisperX, Proxmox".
INITIAL_PROMPT=

# ---- Upload web page (the :8080 fileserver) ----
# LINKS_PORT=8080          -> host port for the upload/transcript page
# MAX_UPLOAD_MB=2048       -> reject browser uploads larger than this
# UPLOAD_TOKEN=            -> if set, uploads require ?token=<value> (open if blank).
#   Set this if :8080 is reachable beyond your LAN — an open upload box lets anyone
#   queue jobs and run up RunPod GPU cost. Then upload via http://host:8080/?token=...
LINKS_PORT=8080
MAX_UPLOAD_MB=2048
UPLOAD_TOKEN=

# ---- Speaker identification (optional; extra <stem>.speakers.json) ----
# Tags which diarized speaker is which known person by matching their voice to
# reference clips in refs/<Name>.<ext> (gitignored). Never edits the transcript
# files. SPEAKER_MIN_SIM is the cosine cutoff (0.70 default); .speakers.json
# reports the similarity so you can tune it. Set SPEAKER_ID=false to disable.
SPEAKER_ID=true
SPEAKER_MIN_SIM=0.70

# ---- Behaviour (sane defaults; usually leave as-is) ----
# KEEP_REMOTE_AUDIO=false  -> deletes the uploaded audio from RunPod after each job
# DELETE_INPUT_AFTER=false -> moves processed input to done/ instead of deleting
KEEP_REMOTE_AUDIO=false
DELETE_INPUT_AFTER=false
POLL_INTERVAL=15
JOB_TIMEOUT=7200
